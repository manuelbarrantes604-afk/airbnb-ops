# Copy to .env.local for local development. NEVER commit real values.
# Production values go in Vercel → Project → Settings → Environment Variables.

# Supabase project URL and publishable (public) key — safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET key — server only (used to create invited accounts). Never expose.
SUPABASE_SECRET_KEY=sb_secret_...

# Leave both NEXT_PUBLIC_ values empty to run the fictional DEMO.
